# ==============================================================================
# KONFIGURASI ENVIRONMENT — PORTAL ADMIN KOST PUTRA AGAN
# Salin file ini menjadi ".env" saat menjalankan di VS Code / lokal atau
# masukkan variabel di bawah pada dashboard Hosting (Vercel / Netlify / dll).
# Jangan pernah meng-commit file ".env" asli ke GitHub!
# ==============================================================================

# URL aplikasi untuk tautan pembayaran & verifikasi kwitansi QR
APP_URL="http://localhost:3000"

# Email Pemilik Utama (mendapat akses Owner otomatis saat pertama login Google)
# Ganti dengan email Google pemilik kost saat serah terima penuh
VITE_PRIMARY_OWNER_EMAIL="ekall2h@gmail.com"

# Konfigurasi Firebase (opsional jika sudah memakai firebase-applet-config.json;
# wajib diisi jika memindahkan aplikasi ke Firebase Project milik pemilik kost)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
